# Copy this file to ".env" (same folder as app.py) and fill it in. Never share or upload the .env file.

# --- Gmail (email with photos attached) ---
# Create an App Password: Google Account > Security > 2-Step Verification > App passwords
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
NOTIFY_EMAIL=yourname@gmail.com

# --- WhatsApp (WhatsApp Business Cloud API from Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Your own number that receives the alerts, with country code, digits only
WHATSAPP_TO=918439136097
# Optional: an approved message template with ONE text variable {{1}}. Needed so alerts arrive even when you
# have not messaged the business number in the last 24 hours.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# --- Site / security ---
SITE_URL=https://www.yourdomain.in
# ONLY when the site is live on a real domain behind https, remove the leading # on these 3 lines.
# (Leave them OFF on your own computer: FORCE_HTTPS makes http://localhost:8000 stop working.)
# COOKIE_SECURE=1
# FORCE_HTTPS=1
# TRUST_PROXY=1
